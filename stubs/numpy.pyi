# linalg submodule
class linalg:
    @staticmethod
    def inv(a: Any) -> ndarray: ...
    @staticmethod
    def pinv(a: Any) -> ndarray: ...
    @staticmethod
    def solve(a: Any, b: Any) -> ndarray: ...
    @staticmethod
    def lstsq(a: Any, b: Any, rcond: Optional[Any] = None) -> Tuple[ndarray, Any, int, Any]: ...

# fft submodule
class fft:
    @staticmethod
    def rfft(a: Any, n: Optional[int] = None, axis: int = -1) -> ndarray: ...
    @staticmethod
    def irfft(a: Any, n: Optional[int] = None, axis: int = -1) -> ndarray: ...

# polynomial submodule
class polynomial:
    class hermite_e:
        @staticmethod
        def hermegauss(deg: int) -> Tuple[ndarray, ndarray]: ...

# random submodule
class _Generator:
    def integers(self, low: int, high: Optional[int] = None, size: Optional[Any] = None) -> Any: ...
    def normal(self, loc: float = 0.0, scale: float = 1.0, size: Optional[Any] = None) -> Any: ...
    def uniform(self, low: float = 0.0, high: float = 1.0, size: Optional[Any] = None) -> Any: ...

class random:
    @staticmethod
    def seed(seed: Optional[int] = None) -> None: ...
    @staticmethod
    def uniform(low: float = 0.0, high: float = 1.0, size: Optional[Any] = None) -> Any: ...
    @staticmethod
    def normal(loc: float = 0.0, scale: float = 1.0, size: Optional[Any] = None) -> Any: ...
    @staticmethod
    def default_rng(seed: Optional[int] = None) -> _Generator: ...

