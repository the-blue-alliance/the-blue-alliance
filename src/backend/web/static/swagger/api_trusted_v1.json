  },
  "servers": [
    {
      "url": "https://www.thebluealliance.com/api/trusted/v1"
    }
  ],
  "components": {
    "parameters": {
      "eventKeyParam": {
        "name": "eventKey",
        "in": "path",
        "description": "TBA event key. For example, 2017cthar",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "successResponse": {
        "description": "The operation completed successfully",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Success"
            }
          }
        }
      },
      "badRequestResponse": {
        "description": "The request body could not be parsed or failed validation",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "unauthorizedResponse": {
        "description": "The request was not authorized: `X-TBA-Auth-Id` or `X-TBA-Auth-Sig` is missing or invalid, the keys are not allowed to edit this event or lack the permission this endpoint needs, the keys have expired, or the trusted API has been disabled by the TBA admins",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "notFoundResponse": {
        "description": "The event key is malformed or the event does not exist",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "authId": {
        "type": "apiKey",
        "description": "An identifier given to you by the TBA Admins",
        "in": "header",
        "name": "X-TBA-Auth-Id"
      },
      "authSig": {
        "type": "apiKey",
        "in": "header",
        "description": "The MD5 hex digest of the concatenation of your auth secret, the request path (starting with `/api/trusted/v1`), and the request body",
        "name": "X-TBA-Auth-Sig"
      }
    },
    "schemas": {
      "AllianceList": {
        "type": "array",
        "items": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "A team key, in the format `frcXXXX` where `XXXX` is the team number. For example, team 254's key would be `frc254`.",
            "example": "frc254"
          }
        }
      },
      "Award": {
        "type": "object",
        "required": [
          "name_str"
        ],
        "properties": {
          "type_enum": {
            "type": "integer",
            "description": "Type enum of the award. If null or unrecognized, this will be automatically determined from the name_str. See https://github.com/the-blue-alliance/the-blue-alliance/blob/main/src/backend/common/consts/award_type.py",
            "example": 1,
            "nullable": true
          },
          "name_str": {
            "type": "string",
            "description": "Name of the award",
            "example": "Regional Winner"
          },
          "team_key": {
            "type": "string",
            "description": "Key of the team winning this award. Formatted like `frcXXXX` where `XXXX` is the team number. Can be null",
            "example": "frc254",
            "nullable": true
          },
          "awardee": {
            "type": "string",
            "description": "Name of the individual winning this award. Can be null",
            "example": "Bob Bobby",
            "nullable": true
          }
        },
        "description": "At least one of `team_key` or `awardee` must be set. Awards that resolve to the same award type are merged into a single award with multiple recipients"
      },
      "EventInfo": {
        "type": "object",
        "properties": {
          "first_event_code": {
            "type": "string",
            "nullable": true,
            "description": "Event code used to sync data with FIRST. Setting a code marks the event as official so it syncs from FIRST; null or an empty string clears it",
            "example": "IRI"
          },
          "playoff_type": {
            "type": "integer",
            "nullable": true,
            "description": "Integer constant representing the playoff format. References constants defined under `PlayoffType`: https://github.com/the-blue-alliance/the-blue-alliance/blob/main/src/backend/common/consts/playoff_type.py#L37",
            "example": 0
          },
          "webcasts": {
            "type": "array",
            "description": "A list of webcasts to set for this event. This will overwrite the existing webcast list. Provide either `url`, or `type` and `channel`. YouTube webcasts must set `date`, and the date must fall within the event's dates",
            "items": {
              "type": "object",
              "description": "A webcast object",
              "properties": {
                "url": {
                  "type": "string",
                  "description": "A webcast url, parsed to extract the webcast type and channel",
                  "example": "https://youtu.be/abc123"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "twitch",
                    "youtube",
                    "iframe",
                    "mms",
                    "rtmp",
                    "ustream",
                    "livestream",
                    "html5",
                    "dacast",
                    "stemtv"
                  ],
                  "description": "Type of webcast. Required if url is not provided",
                  "example": "youtube"
                },
                "channel": {
                  "type": "string",
                  "description": "Channel identifier for the webcast. Required if url is not provided",
                  "example": "abc123"
                },
                "date": {
                  "type": "string",
                  "format": "date",
                  "description": "Date in YYYY-MM-DD format for when the webcast aired. Required for YouTube webcasts",
                  "example": "2024-01-15"
                }
              }
            }
          },
          "remap_teams": {
            "type": "object",
            "description": "A mapping of temp key --> remapped key (including B team keys)",
            "additionalProperties": {
              "type": "string"
            },
            "example": {
              "frc1337": "frc337B"
            }
          },
          "timezone": {
            "type": "string",
            "description": "Timezone name for the event",
            "example": "America/New_York"
          },
          "disable_sync": {
            "type": "object",
            "description": "Flags controlling disabling certain aspects of sync. Unknown keys are rejected",
            "properties": {
              "event_alliances": {
                "type": "boolean"
              },
              "event_rankings": {
                "type": "boolean"
              },
              "event_qual_matches": {
                "type": "boolean"
              },
              "event_playoff_matches": {
                "type": "boolean"
              },
              "event_awards": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "EventInfoResponse": {
        "type": "object",
        "properties": {
          "first_event_code": {
            "type": "string",
            "nullable": true,
            "description": "Event code used to sync data with FIRST. Null when the event does not sync from FIRST",
            "example": "IRI"
          },
          "playoff_type": {
            "type": "integer",
            "nullable": true,
            "description": "Integer constant representing the playoff format. References constants defined under `PlayoffType`: https://github.com/the-blue-alliance/the-blue-alliance/blob/main/src/backend/common/consts/playoff_type.py",
            "example": 10
          },
          "webcasts": {
            "type": "array",
            "description": "The event's current webcasts",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "example": "youtube",
                  "enum": [
                    "twitch",
                    "youtube",
                    "iframe",
                    "mms",
                    "rtmp",
                    "ustream",
                    "livestream",
                    "html5",
                    "dacast",
                    "stemtv"
                  ]
                },
                "channel": {
                  "type": "string",
                  "example": "abc123"
                },
                "file": {
                  "type": "string"
                },
                "date": {
                  "type": "string",
                  "example": "2024-01-15"
                }
              }
            }
          },
          "remap_teams": {
            "type": "object",
            "description": "A mapping of temp key --> remapped key (including B team keys)",
            "additionalProperties": {
              "type": "string"
            },
            "example": {
              "frc1337": "frc337B"
            }
          },
          "timezone": {
            "type": "string",
            "nullable": true,
            "description": "Timezone name for the event",
            "example": "America/New_York"
          },
          "sync_disabled_flags": {
            "type": "integer",
            "description": "Bitmask of the sync parts disabled via `disable_sync`: event_alliances = 1, event_rankings = 2, event_qual_matches = 4, event_playoff_matches = 8, event_awards = 16",
            "example": 0
          }
        }
      },
      "MatchAlliance": {
        "type": "object",
        "required": [
          "teams",
          "score"
        ],
        "properties": {
          "teams": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Key of a team on the alliance, in the format `frcXXXX` where `XXXX` is the team number",
              "example": "frc254"
            }
          },
          "score": {
            "type": "integer",
            "format": "int32",
            "description": "Score of the match. Null means the match has not been played",
            "example": 10,
            "nullable": true
          },
          "surrogates": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Key of a surrogate team on the alliance, in the format `frcXXXX` where `XXXX` is the team number",
              "example": "frc254"
            }
          },
          "dqs": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Key of a disqualified team on the alliance, in the format `frcXXXX` where `XXXX` is the team number",
              "example": "frc254"
            }
          }
        }
      },
      "Match": {
        "type": "object",
        "required": [
          "comp_level",
          "match_number",
          "set_number",
          "alliances"
        ],
        "properties": {
          "comp_level": {
            "type": "string",
            "enum": [
              "pm",
              "qm",
              "ef",
              "qf",
              "sf",
              "f"
            ],
            "description": "Competition level of the match",
            "example": "qm"
          },
          "set_number": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "description": "Set number of the match. Ignored for `qm` matches, which always use set 1",
            "example": 1
          },
          "match_number": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "description": "Number of the match in the current set",
            "example": 1
          },
          "alliances": {
            "type": "object",
            "description": "Competing teams and score info for this match",
            "required": [
              "red",
              "blue"
            ],
            "properties": {
              "red": {
                "$ref": "#/components/schemas/MatchAlliance"
              },
              "blue": {
                "$ref": "#/components/schemas/MatchAlliance"
              }
            }
          },
          "score_breakdown": {
            "type": "object",
            "nullable": true,
            "description": "Score breakdown for each alliance. Valid keys vary by year and match the score breakdown fields in APIv3 (the example uses 2026 keys); a key that is not valid for the event's year is rejected with a 400 that lists the valid keys.",
            "properties": {
              "red": {
                "type": "object",
                "additionalProperties": true
              },
              "blue": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "example": {
              "red": {
                "totalAutoPoints": 20,
                "totalTeleopPoints": 40,
                "foulPoints": 0,
                "totalPoints": 60
              },
              "blue": {
                "totalAutoPoints": 15,
                "totalTeleopPoints": 35,
                "foulPoints": 5,
                "totalPoints": 55
              }
            }
          },
          "time_str": {
            "type": "string",
            "description": "String in the format \"(H)H:MM AM/PM\" for when the match will be played in the event's local timezone",
            "example": "9:15 AM"
          },
          "time_utc": {
            "type": "string",
            "description": "UTC time of the match's scheduled time in ISO 8601 format (YYYY-MM-DDTHH:MM:SS)",
            "example": "2008-01-02T10:30:00.000Z",
            "format": "date-time"
          },
          "actual_start_time_utc": {
            "type": "string",
            "description": "UTC time of when the match actually started in ISO 8601 format (YYYY-MM-DDTHH:MM:SS)",
            "example": "2008-01-02T10:30:00.000Z",
            "format": "date-time"
          },
          "post_results_time_utc": {
            "type": "string",
            "description": "UTC time of when the match results were shown to the audience in ISO 8601 format (YYYY-MM-DDTHH:MM:SS)",
            "example": "2008-01-02T10:30:00.000Z",
            "format": "date-time"
          },
          "display_name": {
            "type": "string",
            "description": "The name for the match, to be shown on the event page",
            "example": "Quals 10"
          }
        }
      },
      "Webcast": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Optional URL that will be parsed to extract webcast type and channel. Either provide url OR type+channel+file",
            "example": "https://youtu.be/abc123"
          },
          "type": {
            "type": "string",
            "description": "Type of webcast. Required if url is not provided",
            "example": "youtube",
            "enum": [
              "twitch",
              "youtube",
              "iframe",
              "mms",
              "rtmp",
              "ustream",
              "livestream",
              "html5",
              "dacast",
              "stemtv"
            ]
          },
          "channel": {
            "type": "string",
            "description": "Channel identifier for the webcast. Required if url is not provided",
            "example": "abc123"
          },
          "file": {
            "type": "string",
            "description": "Optional file identifier for certain webcast types",
            "example": "stream.mp4"
          },
          "date": {
            "type": "string",
            "description": "Optional date in YYYY-MM-DD format for when the webcast aired",
            "example": "2024-01-15"
          }
        }
      },
      "WebcastUpdate": {
        "type": "object",
        "required": [
          "webcasts"
        ],
        "properties": {
          "webcasts": {
            "type": "array",
            "description": "List of webcasts to add or remove",
            "items": {
              "$ref": "#/components/schemas/Webcast"
            }
          }
        }
      },
      "ZebraTeam": {
        "type": "object",
        "required": [
          "team_key",
          "xs",
          "ys"
        ],
        "properties": {
          "team_key": {
            "type": "string",
            "description": "Team key, like `frcXXXX` where `XXXX` is the team number",
            "example": "frc254"
          },
          "xs": {
            "type": "array",
            "description": "X coordinates in feet, one per entry in `times`. Null where no position was recorded; must be null at the same indices as `ys`",
            "items": {
              "type": "number",
              "format": "float",
              "nullable": true
            },
            "example": [
              null,
              1.2,
              1.3
            ]
          },
          "ys": {
            "type": "array",
            "description": "Y coordinates in feet, one per entry in `times`. Null where no position was recorded; must be null at the same indices as `xs`",
            "items": {
              "type": "number",
              "format": "float",
              "nullable": true
            },
            "example": [
              null,
              0.1,
              0.1
            ]
          }
        }
      },
      "ZebraMotionWorks": {
        "type": "object",
        "required": [
          "key",
          "times",
          "alliances"
        ],
        "properties": {
          "key": {
            "type": "string",
            "description": "Full match key. Must belong to the event in the path",
            "example": "2020casj_qm1"
          },
          "times": {
            "type": "array",
            "description": "Elapsed match time in seconds for each sample. Must be non-empty floats",
            "items": {
              "type": "number",
              "format": "float"
            },
            "example": [
              0.0,
              0.5,
              1.0
            ]
          },
          "alliances": {
            "type": "object",
            "required": [
              "red",
              "blue"
            ],
            "properties": {
              "red": {
                "type": "array",
                "description": "Exactly 3 teams",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "$ref": "#/components/schemas/ZebraTeam"
                }
              },
              "blue": {
                "type": "array",
                "description": "Exactly 3 teams",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "$ref": "#/components/schemas/ZebraTeam"
                }
              }
            }
          }
        }
      },
      "Success": {
        "type": "object",
        "properties": {
          "Success": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "Error": {
            "type": "string"
          }
        }
      }
    }
  }
}
