{
  "openapi": "3.1.0",
  "info": {
    "title": "TBA Mobile API",
    "version": "v9",
    "description": "API for TBA Mobile clients"
  },
  "servers": [
    {
      "url": "https://www.thebluealliance.com/clientapi/tbaClient/v9"
    }
  ],
  "components": {
    "schemas": {
      "BaseResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int64"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ModelType": {
        "type": "integer",
        "enum": [
          0,
          1,
          2,
          3,
          4,
          5,
          6,
          7
        ],
        "description": "The type of model (0=Event, 1=Team, 2=Match, 3=EventTeam, 4=District, 5=DistrictTeam, 6=Award, 7=Media)"
      },
      "NotificationType": {
        "type": "string",
        "enum": [
          "upcoming_match",
          "match_score",
          "alliance_selection",
          "awards_posted",
          "match_video_added"
        ],
        "description": "Notification type (upcoming_match=Upcoming Match, match_score=Match Score, alliance_selection=Alliance Selection, awards_posted=Awards Posted, match_video_added=Match Video Added)"
      },
      "FavoriteCollection": {
        "type": "object",
        "properties": {
          "favorites": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FavoriteMessage"
            }
          }
        }
      },
      "FavoriteMessage": {
        "type": "object",
        "required": [
          "model_key",
          "model_type"
        ],
        "properties": {
          "device_key": {
            "type": "string"
          },
          "model_key": {
            "type": "string"
          },
          "model_type": {
            "$ref": "#/components/schemas/ModelType"
          }
        }
      },
      "SubscriptionCollection": {
        "type": "object",
        "properties": {
          "subscriptions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SubscriptionMessage"
            }
          }
        }
      },
      "MediaSuggestionMessage": {
        "type": "object",
        "required": [
          "reference_key",
          "reference_type",
          "year",
          "media_url",
          "details_json"
        ],
        "properties": {
          "reference_key": {
            "type": "string",
            "description": "The key of the model the suggestion is for (e.g. team key)"
          },
          "reference_type": {
            "type": "string",
            "description": "The type of model the suggestion is for (currently only 'team' is supported)"
          },
          "year": {
            "type": "integer",
            "description": "The year the media is from"
          },
          "media_url": {
            "type": "string",
            "description": "The URL of the media being suggested"
          },
          "details_json": {
            "type": "string",
            "description": "Optional JSON-encoded details about the media"
          }
        }
      },
      "SubscriptionMessage": {
        "type": "object",
        "required": [
          "model_key",
          "model_type"
        ],
        "properties": {
          "device_key": {
            "type": "string"
          },
          "model_key": {
            "type": "string"
          },
          "model_type": {
            "$ref": "#/components/schemas/ModelType"
          },
          "notifications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NotificationType"
            }
          }
        }
      },
      "ApiReadKeyMessage": {
        "type": "object",
        "required": [
          "key",
          "description"
        ],
        "properties": {
          "key": {
            "type": "string",
            "description": "The X-TBA-Auth-Key value"
          },
          "description": {
            "type": "string"
          },
          "created": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO-formatted creation datetime"
          }
        }
      },
      "ApiWriteKeyMessage": {
        "type": "object",
        "required": [
          "auth_id",
          "secret",
          "description",
          "event_keys",
          "auth_types"
        ],
        "properties": {
          "auth_id": {
            "type": "string"
          },
          "secret": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "event_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "auth_types": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Human-readable write permission names"
          },
          "expiration": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO-formatted expiration datetime"
          }
        }
      },
      "ApiKeysResponse": {
        "type": "object",
        "properties": {
          "read_keys": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApiReadKeyMessage"
            }
          },
          "write_keys": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApiWriteKeyMessage"
            }
          }
        }
      },
      "AddApiReadKeyResponse": {
        "type": "object",
        "properties": {
          "read_key": {
            "$ref": "#/components/schemas/ApiReadKeyMessage"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "ApiKey": {
        "type": "apiKey",
        "in": "query",
        "name": "key"
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    },
    {
      "ApiKey": []
    }
  ],
  "paths": {
    "/favorites/list": {
      "post": {
        "summary": "List favorites",
        "operationId": "listFavorites",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FavoriteCollection"
                }
              }
            }
          }
        }
      }
    },
    "/model/setPreferences": {
      "post": {
        "summary": "Set model preferences",
        "operationId": "setModelPreferences",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model_key",
                  "model_type",
                  "device_key",
                  "notifications",
                  "favorite"
                ],
                "properties": {
                  "model_key": {
                    "type": "string",
                    "description": "The key of the model to set preferences for"
                  },
                  "model_type": {
                    "$ref": "#/components/schemas/ModelType"
                  },
                  "device_key": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The device key to exclude from sync notifications"
                  },
                  "notifications": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/NotificationType"
                    },
                    "description": "List of notification type names"
                  },
                  "favorite": {
                    "type": "boolean",
                    "description": "Whether to favorite the model"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          }
        }
      }
    },
    "/team/media/suggest": {
      "post": {
        "summary": "Suggest team media",
        "operationId": "suggestTeamMedia",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MediaSuggestionMessage"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          }
        }
      }
    },
    "/subscriptions/list": {
      "post": {
        "summary": "List subscriptions",
        "operationId": "listSubscriptions",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubscriptionCollection"
                }
              }
            }
          }
        }
      }
    },
    "/api_keys/list": {
      "post": {
        "summary": "List API keys",
        "operationId": "listApiKeys",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiKeysResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api_keys/read/add": {
      "post": {
        "summary": "Add a read API key",
        "operationId": "addApiReadKey",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "description"
                ],
                "properties": {
                  "description": {
                    "type": "string",
                    "description": "Human-readable description of the key"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddApiReadKeyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api_keys/read/delete": {
      "post": {
        "summary": "Delete a read API key",
        "operationId": "deleteApiReadKey",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "key_id"
                ],
                "properties": {
                  "key_id": {
                    "type": "string",
                    "description": "The id of the read key to delete"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          }
        }
      }
    }
  }
}